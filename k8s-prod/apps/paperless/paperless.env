# Settings shared by the webserver (paperless.yaml) and the export CronJob (export.yaml), as ConfigMap 'paperless-env'
# (kustomization.yaml). Format: KEY=value without quotes; only whole-line comments.
# https://docs.paperless-ngx.com/configuration/
PAPERLESS_URL=https://paperless.ingress.prod.k8s.renklus.ch
PAPERLESS_REDIS=redis://paperless-redis:6379
# Database from postgres.yaml; the password comes from the Secret CNPG generates
PAPERLESS_DBENGINE=postgresql
PAPERLESS_DBHOST=paperless-database-rw
PAPERLESS_DBNAME=app
PAPERLESS_DBUSER=app
PAPERLESS_TIME_ZONE=Europe/Zurich
PAPERLESS_OCR_LANGUAGE=deu+eng
PAPERLESS_DATE_PARSER_LANGUAGES=de-CH+en-CH
PAPERLESS_FILENAME_FORMAT={{ created_year }}/{{ correspondent }}/{{ created }} - {{ title }} - {{ doc_pk }}
# days, about 5 years
PAPERLESS_EMPTY_TRASH_DELAY=1800
# must exist before configuring this setting (could be helpful: https://docs.paperless-ngx.com/advanced_usage/#custom-container-initialization)
# - name: PAPERLESS_EMPTY_TRASH_DIR
#   value: "/usr/src/paperless/trash-empty-dir" # storage of PDFs after trash was emptied
            
# seconds, default: 1800
PAPERLESS_WORKER_TIMEOUT=7200
# NFS has no inotify, so poll the consume folder
PAPERLESS_CONSUMER_POLLING_INTERVAL=30
# OCR threads, matching the CPU limit in paperless.yaml (default: all host cores)
PAPERLESS_THREADS_PER_WORKER=2
# Celery monitoring on port 5555, behind a Traefik login (flower.yaml)
PAPERLESS_ENABLE_FLOWER=true
# Traefik is the only proxy hop, so login rate limiting uses the client IP from X-Forwarded-For
PAPERLESS_ALLAUTH_TRUSTED_PROXY_COUNT=1
# set to birth date. Do through hashicorp for privacy
# - name: PAPERLESS_IGNORE_DATES
#   value: ""
          