{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "docker:enableMajor",
    "group:monorepos",
    "group:recommended",
    ":disableRateLimiting",
    ":docker"
  ],
  "minimumReleaseAge": "1 day",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "argocd": {
    "managerFilePatterns": [
      "/k8s-rancher/apps/.+\\.yaml$/",
      "/k8s-prod/apps/.+\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/k8s-rancher/apps/.+\\.yaml$/",
      "/k8s-prod/apps/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/k8s-rancher/apps/.+\\.yaml$/",
      "/k8s-prod/apps/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileFormat": "yaml",
      "managerFilePatterns": [
        "/DISABLE-THIS-RULE/k8s/apps/.+\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\n\\s+\\S+?:\\s?\\'(?<currentValue>[^\\s\\@]+)(\\@(?<currentDigest>\\S+))?\\'"
      ]
    },
    {
      "customType": "regex",
      "fileFormat": "yaml",
      "managerFilePatterns": [
        "/DISABLE-THIS-RULE/k8s/apps/app-of-infrastructure-apps/csi-nfs\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^(?<indentation>\\s*)repository:\\s*'(?<packageName>[^']+)'[\\s]*?tag:\\s*'(?<currentValue>[^'@]+)(?:@(?<currentDigest>[^']+))?'",
        "problem when fileFormat missing: https://github.com/renovatebot/renovate/issues/24559"
      ],
      "autoReplaceStringTemplate": "{{indentation}}repository: '{{packageName}}'\n{{{indentation}}}tag: '{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}'",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/k8s-rancher/apps/.+\\.yaml$/",
        "/k8s-prod/apps/.+\\.yaml$/"
      ],
      "matchStrings": [
        "kubernetesVersion: '?(?<currentValue>[^'\\s]+)'?[\\S\\s]*$"
      ],
      "depNameTemplate": "k3s",
      "packageNameTemplate": "k3s-io/k3s",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?<compatibility>\\+k3s)(?<build>\\d+)$",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "CloudNativePG Cluster imageName. Tags are '<postgres>-<vectorchord>', e.g. '18.6-1.1.1'",
      "managerFilePatterns": [
        "/k8s-rancher/apps/.+\\.yaml$/",
        "/k8s-prod/apps/.+\\.yaml$/"
      ],
      "matchStrings": [
        "imageName: '(?<depName>ghcr\\.io/tensorchord/cloudnative-vectorchord):(?<currentValue>[^'@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?'"
      ],
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d+)\\.(?<build>\\d+)\\.(?<revision>\\d+)$",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "CloudNativePG Cluster imageName. Tags are '<postgres>-<variant>-<distro>', e.g. '18.6-minimal-trixie'; docker versioning keeps the suffix",
      "managerFilePatterns": [
        "/k8s-rancher/apps/.+\\.yaml$/",
        "/k8s-prod/apps/.+\\.yaml$/"
      ],
      "matchStrings": [
        "imageName: '(?<depName>ghcr\\.io/cloudnative-pg/postgresql):(?<currentValue>[^'@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?'"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "customDatasources": {
    "k3s": {
      "description": "UNUSED: Use with datasourceTemplate=custom.k3s",
      "defaultRegistryUrlTemplate": "https://update.k3s.io/v1-release/channels",
      "transformTemplates": [
        "{\"releases\":[{\"version\": $$.(data[id = 'stable'].latest),\"sourceUrl\":\"https://github.com/k3s-io/k3s\",\"changelogUrl\":$join([\"https://github.com/k3s-io/k3s/releases/tag/\",data[id = 'stable'].latest])}],\"sourceUrl\": \"https://github.com/k3s-io/k3s\",\"homepage\": \"https://k3s.io/\"}"
      ]
    }
  },
  "ignorePaths": [
    "k8s-old1/**",
    "k8s-dmz/**",
    "k8s/**",
    "images/paperless-backup/**",
    ".github/workflows/publish-paperless-backup.yml"
  ],
  "packageRules": [
    {
      "description": "One PR per app and cluster. Same-named apps on both clusters would otherwise share a branch and PR title, and a merged PR for one cluster blocks the other's identical update",
      "matchFileNames": [
        "k8s-rancher/apps/**",
        "k8s-prod/apps/**"
      ],
      "matchManagers": [
        "argocd",
        "kubernetes",
        "helm-values"
      ],
      "groupName": "{{{replace 'k8s-(?<Cluster>[^/]+)\\/apps\\/(?<App>[^/.]+).*' '$<Cluster> app $<App>' packageFile}}}"
    },
    {
      "matchFileNames": [
        "k8s-rancher/apps/**",
        "k8s-prod/apps/**"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "{{{replace 'k8s-(?<Cluster>[^/]+)\\/apps\\/(?<App>[^/.]+).*' '$<Cluster> app $<App> (regex-match)' packageFile}}}"
    },
    {
      "description": "prometheus-operator-crds must match the operator version of kube-prometheus-stack, on both clusters",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "kube-prometheus-stack",
        "prometheus-operator-crds"
      ],
      "groupName": "prometheus-operator"
    },
    {
      "description": "Major releases get more time for breaking-change reports and quick follow-up fixes",
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "5 days"
    },
    {
      "description": "Rancher only supports new k3s major and minor releases some time after they are published",
      "matchDepNames": [
        "k3s"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "minimumReleaseAge": "60 days"
    },
    {
      "description": "Immich supports VectorChord >= 0.3, < 2.0 (https://immich.app/docs/administration/postgres-standalone). Tags are '<postgres>-<vectorchord>'",
      "matchPackageNames": [
        "ghcr.io/tensorchord/cloudnative-vectorchord"
      ],
      "allowedVersions": "/^\\d+\\.\\d+-1\\.\\d+\\.\\d+$/"
    },
    {
      "description": "A new Postgres major makes CNPG run an in-place major upgrade that cannot be rolled back. Test restoring a database dump first, then approve it on the Dependency Dashboard",
      "matchPackageNames": [
        "ghcr.io/tensorchord/cloudnative-vectorchord"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "paperless-pwa-share tags releases '0.2.0' and prereleases '0.2.1-dev.13'. Docker versioning would read '-dev.13' as a compatibility suffix and never leave it; semver also skips the floating tags '0', '0.2', 'latest' and 'dev'. Own app, so no release-age wait (after the 'major' rule to override it too). Prod gets released versions only (ignoreUnstable default)",
      "matchPackageNames": [
        "ghcr.io/renklus/paperless-pwa-share"
      ],
      "versioning": "semver",
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "The paperless-pwa-share test instance follows every prerelease and deploys it without a PR. ignoreTests: the repo has no CI checks, which would otherwise block automerge",
      "matchFileNames": [
        "k8s-prod/apps/paperless-pwa-share-test/**"
      ],
      "matchPackageNames": [
        "ghcr.io/renklus/paperless-pwa-share"
      ],
      "ignoreUnstable": false,
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "description": "Low risk updates. The wait is mandatory: 'strict' keeps the branch from being created before then (ignoreTests would otherwise let a branch with a pending stability check merge), and 'timestamp-required' skips releases without a publish timestamp instead of treating them as old enough. ignoreTests: the repo has no CI checks, which would otherwise block automerge",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "prometheus-blackbox-exporter",
        "kube-prometheus-stack",
        "prometheus-operator-crds",
        "haproxy",
        "docker.io/haproxytech/haproxy-alpine"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "internalChecksFilter": "strict",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "matchPackageNames": [
        "plexinc/pms-docker"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+\\-[a-z0-9]+)$"
    },
    {
      "matchPackageNames": [
        "ghcr.io/oliver006/redis_exporter"
      ],
      "enabled": true
    }
  ]
}
