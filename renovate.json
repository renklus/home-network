{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "docker:enableMajor",
    "group:monorepos",
    "group:recommended",
    ":disableRateLimiting",
    ":docker"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/k8s-rancher/apps/.+\\.yaml$/",
      "/k8s-prod/apps/.+\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/k8s-rancher/apps/.+\\.yaml$/",
      "/k8s-prod/apps/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/k8s-rancher/apps/.+\\.yaml$/",
      "/k8s-prod/apps/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileFormat": "yaml",
      "managerFilePatterns": [
        "/DISABLE-THIS-RULE/k8s/apps/.+\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\n\\s+\\S+?:\\s?\\'(?<currentValue>[^\\s\\@]+)(\\@(?<currentDigest>\\S+))?\\'"
      ]
    },
    {
      "customType": "regex",
      "fileFormat": "yaml",
      "managerFilePatterns": [
        "/DISABLE-THIS-RULE/k8s/apps/app-of-infrastructure-apps/csi-nfs\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^(?<indentation>\\s*)repository:\\s*'(?<packageName>[^']+)'[\\s]*?tag:\\s*'(?<currentValue>[^'@]+)(?:@(?<currentDigest>[^']+))?'",
        "problem when fileFormat missing: https://github.com/renovatebot/renovate/issues/24559"
      ],
      "autoReplaceStringTemplate": "{{indentation}}repository: '{{packageName}}'\n{{{indentation}}}tag: '{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}'",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/k8s-rancher/apps/.+\\.yaml$/",
        "/k8s-prod/apps/.+\\.yaml$/"
      ],
      "matchStrings": [
        "kubernetesVersion: '?(?<currentValue>[^'\\s]+)'?[\\S\\s]*$"
      ],
      "depNameTemplate": "k3s",
      "packageNameTemplate": "k3s-io/k3s",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?<compatibility>\\+k3s)(?<build>\\d+)$",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "CloudNativePG Cluster imageName. Tags are '<postgres>-<vectorchord>', e.g. '18.6-1.1.1'",
      "managerFilePatterns": [
        "/k8s-rancher/apps/.+\\.yaml$/",
        "/k8s-prod/apps/.+\\.yaml$/"
      ],
      "matchStrings": [
        "imageName: '(?<depName>ghcr\\.io/tensorchord/cloudnative-vectorchord):(?<currentValue>[^'@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?'"
      ],
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d+)\\.(?<build>\\d+)\\.(?<revision>\\d+)$",
      "datasourceTemplate": "docker"
    }
  ],
  "customDatasources": {
    "k3s": {
      "description": "UNUSED: Use with datasourceTemplate=custom.k3s",
      "defaultRegistryUrlTemplate": "https://update.k3s.io/v1-release/channels",
      "transformTemplates": [
        "{\"releases\":[{\"version\": $$.(data[id = 'stable'].latest),\"sourceUrl\":\"https://github.com/k3s-io/k3s\",\"changelogUrl\":$join([\"https://github.com/k3s-io/k3s/releases/tag/\",data[id = 'stable'].latest])}],\"sourceUrl\": \"https://github.com/k3s-io/k3s\",\"homepage\": \"https://k3s.io/\"}"
      ]
    }
  },
  "ignorePaths": [
    "k8s-old1/**",
    "k8s-dmz/**",
    "k8s/**"
  ],
  "packageRules": [
    {
      "matchFileNames": [
        "k8s-rancher/apps/*.yaml",
        "k8s-prod/apps/*.yaml"
      ],
      "matchManagers": [
        "argocd",
        "kubernetes",
        "helm-values"
      ],
      "groupName": "{{{replace 'k8s.*\\/(?<FileName>[^/]*)\\.yaml' 'app $<FileName>' packageFile}}}"
    },
    {
      "matchFileNames": [
        "k8s-rancher/apps/*.yaml",
        "k8s-prod/apps/*.yaml"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "{{{replace 'k8s.*\\/(?<FileName>[^/]*)\\.yaml' 'app $<FileName> (regex-match)' packageFile}}}"
    },
    {
      "description": "Rancher only supports new k3s releases some time after they are published",
      "matchDepNames": [
        "k3s"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Immich supports VectorChord >= 0.3, < 2.0 (https://immich.app/docs/administration/postgres-standalone). Tags are '<postgres>-<vectorchord>'",
      "matchPackageNames": [
        "ghcr.io/tensorchord/cloudnative-vectorchord"
      ],
      "allowedVersions": "/^\\d+\\.\\d+-1\\.\\d+\\.\\d+$/"
    },
    {
      "matchPackageNames": [
        "plexinc/pms-docker"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+\\-[a-z0-9]+)$"
    },
    {
      "matchPackageNames": [
        "ghcr.io/oliver006/redis_exporter"
      ],
      "enabled": true
    }
  ]
}
